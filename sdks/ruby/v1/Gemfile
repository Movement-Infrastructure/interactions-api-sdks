# Test-only dependencies for the smoke suite in spec/; runtime deps come from
# the gemspec. Hand-maintained (see .openapi-generator-ignore) because the
# generated Gemfile pins an old rubocop and has no HTTP stubbing gem.
group :development, :test do
  gem "rake", "~> 13.0"
  gem "rspec", "~> 3.13"
  gem "webmock", "~> 3.23"
end
