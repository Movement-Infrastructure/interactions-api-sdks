# openapi-generator ignore file (MIG-1918).
#
# Files listed here are NOT written or overwritten when the SDK is regenerated
# (.github/workflows/generate-python-sdk.yml and python-sdk-tests.yml both run
# the generator into this directory). This protects the hand-written smoke-test
# suite and its supporting files from being clobbered by regeneration.

tests/**
requirements-test.txt
.openapi-generator-ignore

# Written by the oasdiff step in generate-python-sdk.yml, accumulating one
# entry per sync. The generator has no changelog template today, but listing it
# means a future one can't wipe the history.
CHANGELOG.md


# The python generator emits these supporting files, but we don't use them (we
# have our own CI and test suite). Not generating them keeps them out of the
# repo and out of any sdist/source archive. The wheel already excludes test
# code because the generated setup.py uses find_packages(exclude=["test",
# "tests"]). Ignoring a file the generator wouldn't emit anyway is harmless.
.travis.yml
.gitlab-ci.yml
.github/workflows/python.yml
tox.ini
git_push.sh
test-requirements.txt
