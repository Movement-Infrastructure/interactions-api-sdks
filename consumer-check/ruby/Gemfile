source "https://rubygems.org"

# Installs the Ruby SDK from outside its own source tree, the way a consumer
# does. The in-tree suite (sdks/ruby/v1/spec/) runs with the gemspec's own lib/
# on the load path, so it passes even when s.files omits a file that the built
# gem therefore never ships. This harness resolves and installs instead.
#
# SDK_SOURCE picks which build to exercise:
#
#   path  local working tree; no commit needed. The fast loop.
#   git   a pushed branch, resolved as a consumer would. Catches gemspec and
#         dependency-resolution breakage, but NOT packaging: files excluded from
#         s.files still resolve fine from git and only vanish once built.
#   gem   a published version, e.g. SDK_VERSION=0.2.0.pre.1. The only source
#         that exercises the real artifact.
case (source = ENV.fetch("SDK_SOURCE", "path"))
when "path"
  gem "ddx_interactions_api", path: "../../sdks/ruby/v1"
when "git"
  # SSH rather than HTTPS: Bundler clones without a terminal, so a URL that asks
  # for credentials dies on `could not read Username for 'https://github.com'`
  # rather than prompting. This matches how origin is configured.
  gem "ddx_interactions_api",
      git: "git@github.com:Movement-Infrastructure/interactions-api-sdks.git",
      branch: ENV.fetch("SDK_BRANCH", "develop"),
      # The gemspec is not at the repo root, so Bundler needs to be told where.
      glob: "sdks/ruby/v1/*.gemspec"
when "gem"
  # Prereleases are opt-in: an exact pin is what makes Bundler consider one.
  gem "ddx_interactions_api", ENV.fetch("SDK_VERSION")
else
  raise "SDK_SOURCE must be one of: path, git, gem (got #{source.inspect})"
end
